# Copy to .env for local development. Never commit real credentials.
# Local/dev defaults use mock providers and do not require MLS, Telegram, or Twilio.

APP_NAME=realtor-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
INTERNAL_API_KEY=change-me-local-only

# SQLite for local demo. Use Cloud SQL / Postgres in production:
# DATABASE_URL=postgresql+psycopg://realtor:realtor@localhost:5432/realtor_agent
DATABASE_URL=sqlite:///./data/realtor_agent.db
AUTO_CREATE_TABLES=true

REDIS_URL=redis://localhost:6379/0

# env | gcp  — GCP uses Secret Manager names below, never raw DB credentials.
SECRET_BACKEND=env

# mock | live
MLS_PROVIDER=mock
TELEGRAM_MODE=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM=cardanomint@gmail.com
EMAIL_RELAY_TO=cardanomint@gmail.com
EMAIL_RELAY_MODE=true
EMAIL_SUBJECT_PREFIX=[realtor-agent test]
# Gmail SMTP when EMAIL_PROVIDER=smtp. Do not commit the App Password.
# App passwords: https://support.google.com/accounts/answer/185833
# SMTP: https://developers.google.com/workspace/gmail/imap/imap-smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=cardanomint@gmail.com
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_STARTTLS=true

# Watch jrupe7@gmail.com for Damian Einbinder packet replies
# (binder@thehomefinderlv.com / Home Finder Realty).
# IMAP: https://developers.google.com/workspace/gmail/imap/imap-smtp
# App passwords: https://support.google.com/accounts/answer/185833
# jrupe7 is a separate Gmail account from cardanomint. IMAP_PASSWORD must be
# a jrupe7 App Password. Without it, inbox-poll falls back to the SMTP mailbox.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USERNAME=jrupe7@gmail.com
# IMAP_PASSWORD=
# JRUPE7_IMAP_PASSWORD=
# IMAP_WATCH_ADDRESS=jrupe7@gmail.com
# IMAP_MAILBOX=INBOX
# IMAP_POLL_SECONDS=60
# IMAP_LOOKBACK_DAYS=30
# INBOX_STORAGE_PATH=./data/inbox

# Damian's live preference is SMS. Keep relay on so tests never hit investor phones.
SMS_RELAY_MODE=true
# SMS_RELAY_TO=+17025550100
NOTIFY_EMAIL_COPY=true

AI_PROVIDER=mock
ESIGN_PROVIDER=mock
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# Scoring: opportunities below this score are stored but not alerted unless configured.
ALERT_MIN_SCORE=70
ALERT_BELOW_THRESHOLD=false

# Default realtor timezone (Nevada observes Pacific Time).
DEFAULT_TIMEZONE=America/Los_Angeles
DEFAULT_LICENSE_STATE=NV

# --- Live credentials: store in Secret Manager in production. Leave blank locally. ---
# TELEGRAM_BOT_TOKEN=
# Live Telegram for THIS package must be @PirateEye_bot only.
# Never put the TrueHold Wellness (@THWellness_bot) or Mr North (@Mr_North_bot) token here.
# TELEGRAM_WEBHOOK_SECRET=
# Group Damian and the operator share with @PirateEye_bot. Not the North BLS group.
# TELEGRAM_OPERATOR_CHAT_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MLS_API_BASE_URL=
# MLS_API_KEY_SECRET_NAME=
# AI_API_KEY=
# ESIGN_API_KEY=
# GCS_BUCKET=
# GCP_PROJECT_ID=
