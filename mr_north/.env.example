# Mr North hourly BLS + immediate market watch. Independent of Wellness and realtor-agent.
# NORTH_TELEGRAM_BOT_TOKEN=
# Second location (DM or other TrueHold group). Comma-separated ids are allowed.
# NORTH_TELEGRAM_CHAT_ID=
# North BLS / larger-report group (default). Do not use the PirateEye group.
# NORTH_TELEGRAM_GROUP_CHAT_ID=-1003939359929
# Optional extra chats (comma-separated):
# NORTH_TELEGRAM_CHAT_IDS=
# NORTH_TELEGRAM_USERNAME=Mr_North_bot
# Optional extra webhook (Telegram is the primary drop):
# ALERT_WEBHOOK_URL=https://example.invalid/alerts
# Optional BLS v2 key (not required; v1 is used by default):
# BLS_API_KEY=
