# House overlay for n8n Nod self-host.
# Apply only AFTER official `sh setup.sh` in the upstream checkout.
# setup.sh: https://github.com/n8n-io/nod/blob/4178ac0f7e712dd3c1e392e0161aec81af8beb64/deployment/self-host/setup.sh
# config:   https://nod.n8n.io/docs/deploy/configuration/
#
# Do not put NOD_AUTH_TOKEN, NOD_VAULT_KEY, NOD_POSTGRES_PASSWORD, or
# COMPOSE_PROJECT_NAME here. setup.sh generates those once and must keep them.

PORT=4310
NOD_BIND_ADDRESS=127.0.0.1
NOD_PUBLIC_URL=http://localhost:4310
NOD_ANALYTICS_ENABLED=false
NOD_FEEDBACK_ENABLED=false
NOD_ONBOARDING_EMAIL_URL=
NOD_FEEDBACK_URL=
NOD_TRACES_URL=

# House Ollama listens on the Mac at 11434. Inside Nod's Docker stack,
# localhost is the server container, not the Mac.
# https://nod.n8n.io/docs/connect/local-models/
LLM_PROVIDER=compatible
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_COMPATIBLE_API_KEY=
LLM_MODEL=
