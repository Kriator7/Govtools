# TrueHold Wellness only. Never copy realtor-agent/.env or @PirateEye_bot tokens here.
APP_NAME=truehold-wellness
ENVIRONMENT=local
DATABASE_URL=sqlite:///./data/wellness.db
AUTO_CREATE_TABLES=true

# mock | live
TELEGRAM_MODE=mock
# TELEGRAM_BOT_TOKEN=
# Live Telegram for THIS package must be @Npeppers_bot only.
# Never put the realtor @PirateEye_bot token here.
TELEGRAM_OPERATOR_CHAT_ID=

EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_INBOX_PATH=./data/imports/sample_order_emails.json
