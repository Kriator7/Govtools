# TrueHold Wellness only.
APP_NAME=truehold-wellness
ENVIRONMENT=local

# mock | live  — live must be @THWellness_bot (t.me/THWellness_bot)
TELEGRAM_MODE=mock
# TELEGRAM_BOT_TOKEN=

# Staff allowlist. No Telegram command can grant admin.
# Private-chat user id only (positive). Group chat ids are ignored.
# WELLNESS_OPERATOR_USER_IDS=123456789
# WELLNESS_TELEGRAM_CHAT_ID=
# TELEGRAM_OPERATOR_CHAT_ID=

# WELLNESS_ALERT_WEBHOOK_URL=

EMAIL_PROVIDER=mock
EMAIL_INBOX_PATH=./data/imports/sample_reflex_emails.json
# Optional: also ingest the original order-email samples
# EMAIL_INBOX_PATH=./data/imports/sample_order_emails.json

# Optional: floor-team conversational LLM (OpenAI-compatible). Without a key, approved seed lines are used.
# WELLNESS_LLM_API_KEY=
# WELLNESS_LLM_BASE_URL=https://api.x.ai/v1
# WELLNESS_LLM_MODEL=grok-4-1-fast
# XAI_API_KEY=
