# TrueHold Wellness only. Never copy realtor-agent/.env or @PirateEye_bot tokens here.
APP_NAME=truehold-wellness
ENVIRONMENT=local

# mock | live  — live must be @THWellness_bot (t.me/THWellness_bot)
TELEGRAM_MODE=mock
# TELEGRAM_BOT_TOKEN=

# Staff allowlist. /start never grants admin.
# WELLNESS_OPERATOR_USER_IDS=123456789
# WELLNESS_TELEGRAM_CHAT_ID=
# TELEGRAM_OPERATOR_CHAT_ID=
# WELLNESS_OPERATOR_CLAIM_TOKEN=

# Independent of Mr North ALERT_WEBHOOK_URL
# WELLNESS_ALERT_WEBHOOK_URL=

EMAIL_PROVIDER=mock
EMAIL_INBOX_PATH=./data/imports/sample_reflex_emails.json
# Optional: also ingest the original order-email samples
# EMAIL_INBOX_PATH=./data/imports/sample_order_emails.json
